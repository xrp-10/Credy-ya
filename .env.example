# Copiar a .env y cambiar los valores. .env está en el .gitignore: nunca subir claves reales.
DB_NAME=crediya
DB_USERNAME=crediya
DB_PASSWORD=cambia-esta-clave
# Mínimo 32 caracteres. Por ejemplo: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-de-al-menos-32-caracteres
JWT_EXPIRATION_MINUTES=60
# Puertos en la máquina (dentro de la red de Compose siguen siendo 8080 y 5432)
API_HOST_PORT=8080
DB_HOST_PORT=5433
